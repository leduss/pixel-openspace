{
  "name": "pixel-openspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write registry src",
    "registry:build": "shadcn build",
    "cli:build": "bun cli/build.ts",
    "cli": "bun cli/build.ts && node cli/dist/cli.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
  },
  "packageManager": "bun@1.3.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "description": "A pixel-art open space where your scheduled jobs and AI agents come to work. A shadcn/ui component for Next.js and React.",
  "license": "MIT",
  "author": "Julien Dussart",
  "repository": {
    "type": "git",
    "url": "https://github.com/leduss/pixel-openspace"
  },
  "homepage": "https://pixel-openspace.vercel.app"
}
